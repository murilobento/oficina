# Copie este arquivo para .env.local e preencha.

# ---- Banco (Neon) e API ----
# Neon > Connect > connection string (com sslmode=require). Sem ela, `pnpm api` usa um banco em
# memória, só para testar o login; os dados somem ao reiniciar.
DATABASE_URL=
# Chave que assina as sessões. Gere uma com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Endereço público do site (na Vercel, o domínio do projeto). Local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# Outros endereços que podem chamar a API, separados por vírgula (opcional).
APP_ORIGENS=

# ---- Front ----
# "true" liga a tela de login e a proteção das telas (precisa da API no ar).
VITE_LOGIN_ATIVO=false
